{
  "name": "@headless-media/native",
  "version": "0.1.0",
  "description": "React Native wrapper for @headless-media/core — same hook API surface as media-react",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "dependencies": {
    "@headless-media/core": "workspace:*",
    "@headless-media/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "react-native",
    "hooks",
    "media",
    "pexels",
    "sdk"
  ],
  "license": "MIT"
}
